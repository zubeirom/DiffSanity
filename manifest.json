{
  "manifest_version": 3,
  "name": "DiffSanity",
  "version": "0.7.1",
  "description": "Bring sanity back to GitHub diffs. Review pull requests with whole-file diffs, a file list, syntax highlighting and a minimap.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*", "https://*.ghe.com/*"],
      "js": ["content.js"],
      "css": ["github.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://*.ghe.com/*",
    "https://raw.githubusercontent.com/*",
    "https://api.github.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
